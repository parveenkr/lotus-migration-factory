{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Lotus Notes Application Script Blueprint",
	"type": "object",
	"additionalProperties": false,
	"required": ["scriptBlueprintVersion", "traceability", "analysisStatus", "source", "sourceRegions", "scripts", "uiBehaviors", "handoffs", "summary", "dependencies", "findings", "migrationRisks", "migrationHints", "complexity", "validation"],
	"properties": {
		"scriptBlueprintVersion": { "const": "1.1" },
		"traceability": {
			"type": "object",
			"additionalProperties": false,
			"required": ["metadataSource", "generatedBy"],
			"properties": {
				"metadataSource": { "const": "input/ExtractedJson/synopsis.json" },
				"generatedBy": { "const": "lotus-script-analyzer" }
			}
		},
		"analysisStatus": { "$ref": "#/$defs/analysisStatus" },
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["artifacts"],
			"properties": {
				"artifacts": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
			}
		},
		"scripts": { "type": "array", "items": { "$ref": "#/$defs/script" } },
		"sourceRegions": { "type": "array", "items": { "$ref": "#/$defs/sourceRegion" } },
		"uiBehaviors": { "type": "array", "items": { "$ref": "#/$defs/uiBehavior" } },
		"handoffs": {
			"type": "object",
			"additionalProperties": false,
			"required": ["ui"],
			"properties": {
				"ui": {
					"type": "object",
					"additionalProperties": false,
					"required": ["targetAnalyzer", "blueprintPath", "uiBehaviorIds"],
					"properties": {
						"targetAnalyzer": { "const": "lotus-ui-analyzer" },
						"blueprintPath": { "const": "generated/blueprints/scripts/application.script-blueprint.json" },
						"uiBehaviorIds": { "$ref": "#/$defs/ids" }
					}
				}
			}
		},
		"summary": {
			"type": "object",
			"additionalProperties": false,
			"required": ["uiMetadataCount", "buttonVisibilityRuleCount", "buttonEnablementRuleCount", "unknownLanguageCount"],
			"properties": {
				"uiMetadataCount": { "type": "integer", "minimum": 0 },
				"buttonVisibilityRuleCount": { "type": "integer", "minimum": 0 },
				"buttonEnablementRuleCount": { "type": "integer", "minimum": 0 },
				"unknownLanguageCount": { "type": "integer", "minimum": 0 }
			}
		},
		"dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
		"findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
		"migrationRisks": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "description", "findingIds", "mitigation"],
				"properties": {
					"id": { "$ref": "#/$defs/text" },
					"description": { "$ref": "#/$defs/text" },
					"findingIds": { "$ref": "#/$defs/ids" },
					"mitigation": { "$ref": "#/$defs/nullableText" }
				}
			}
		},
		"migrationHints": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["scriptIds", "recommendation", "rationale", "findingIds"],
				"properties": {
					"scriptIds": { "$ref": "#/$defs/evidenceIds" },
					"recommendation": { "$ref": "#/$defs/text" },
					"rationale": { "$ref": "#/$defs/text" },
					"findingIds": { "$ref": "#/$defs/ids" }
				}
			}
		},
		"complexity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["level", "indicators", "scriptIds"],
			"properties": {
				"level": { "enum": ["LOW", "MEDIUM", "HIGH", "VERY_HIGH", "UNKNOWN"] },
				"indicators": { "$ref": "#/$defs/strings" },
				"scriptIds": { "$ref": "#/$defs/ids" }
			}
		},
		"validation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["status", "readyForDownstreamImplementation", "checks", "coverage", "metrics", "blockingFindingIds"],
			"properties": {
				"metrics": {
					"type": "object",
					"additionalProperties": false,
					"required": ["executableRegions", "commentRegions", "commentOnlyReferences", "filteredCommentReferences"],
					"properties": {
						"executableRegions": { "type": "integer", "minimum": 0 },
						"commentRegions": { "type": "integer", "minimum": 0 },
						"commentOnlyReferences": { "type": "integer", "minimum": 0 },
						"filteredCommentReferences": { "type": "integer", "minimum": 0 }
					}
				},
				"status": { "$ref": "#/$defs/checkStatus" },
				"readyForDownstreamImplementation": { "type": "boolean" },
				"checks": {
					"type": "array",
					"minItems": 7,
					"maxItems": 7,
					"items": { "$ref": "#/$defs/check" }
				},
				"coverage": {
					"type": "array",
					"minItems": 4,
					"maxItems": 4,
					"items": { "$ref": "#/$defs/coverage" },
					"allOf": [
						{ "contains": { "properties": { "area": { "const": "LOTUSSCRIPT" } } } },
						{ "contains": { "properties": { "area": { "const": "FORMULA_LANGUAGE" } } } },
						{ "contains": { "properties": { "area": { "const": "JAVA_AGENTS" } } } },
						{ "contains": { "properties": { "area": { "const": "SCRIPT_LIBRARIES" } } } }
					]
				},
				"blockingFindingIds": { "$ref": "#/$defs/ids" }
			}
		}
	},
	"$defs": {
		"text": { "type": "string", "minLength": 1 },
		"nullableText": { "type": ["string", "null"], "minLength": 1 },
		"strings": { "type": "array", "items": { "$ref": "#/$defs/text" } },
		"ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
		"evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
		"analysisStatus": { "enum": ["ANALYZED", "REVIEW_REQUIRED"] },
		"checkStatus": { "enum": ["PASSED", "FAILED", "NOT_RUN"] },
		"sourceRegion": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "classification", "evidenceId", "startOffset", "endOffset", "text", "reviewNotes"],
			"properties": {
				"id": { "$ref": "#/$defs/text" },
				"classification": { "enum": ["EXECUTABLE_CODE", "COMMENT_DOCUMENTATION"] },
				"evidenceId": { "$ref": "#/$defs/text" },
				"startOffset": { "type": "integer", "minimum": 0 },
				"endOffset": { "type": "integer", "minimum": 1 },
				"text": { "$ref": "#/$defs/text" },
				"reviewNotes": { "$ref": "#/$defs/strings" }
			}
		},
		"evidence": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "file", "jsonPointer", "artifactType", "raw"],
			"properties": {
				"id": { "$ref": "#/$defs/text" },
				"file": { "const": "input/ExtractedJson/synopsis.json" },
				"jsonPointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
				"artifactType": { "$ref": "#/$defs/text" },
				"raw": {}
			}
		},
		"script": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "classification", "sourceAppearsExecutable", "languageDetectionAttempted", "name", "kind", "owner", "language", "languageBasis", "languageReason", "context", "sourceAvailability", "evidenceIds", "regionIds", "analysisStatus", "summary", "routines", "operations", "runtimeContext", "dependencyIds", "findingIds"],
			"properties": {
				"id": { "$ref": "#/$defs/text" },
				"classification": { "const": "EXECUTABLE_CODE" },
				"sourceAppearsExecutable": { "const": true },
				"regionIds": { "$ref": "#/$defs/evidenceIds" },
				"languageDetectionAttempted": { "const": true },
				"name": { "$ref": "#/$defs/nullableText" },
				"kind": { "enum": ["AGENT", "EVENT", "ACTION", "FORMULA", "LIBRARY", "SCRIPT_FRAGMENT"] },
				"owner": {
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "name", "alias"],
					"properties": {
						"kind": { "$ref": "#/$defs/text" },
						"name": { "$ref": "#/$defs/nullableText" },
						"alias": { "$ref": "#/$defs/nullableText" }
					}
				},
				"language": { "enum": ["LOTUSSCRIPT", "FORMULA", "JAVA", "OTHER", "UNKNOWN"] },
				"languageBasis": { "enum": ["DECLARED", "INFERRED", "UNKNOWN"] },
				"languageReason": { "$ref": "#/$defs/text" },
				"context": {
					"type": "object",
					"additionalProperties": false,
					"required": ["sourceProperty", "evaluationContext", "event", "triggerType"],
					"properties": {
						"sourceProperty": { "$ref": "#/$defs/text" },
						"evaluationContext": { "$ref": "#/$defs/text" },
						"event": { "$ref": "#/$defs/nullableText" },
						"triggerType": { "$ref": "#/$defs/nullableText" }
					}
				},
				"sourceAvailability": { "enum": ["AVAILABLE", "PARTIAL", "REFERENCE_ONLY", "MISSING"] },
				"evidenceIds": { "$ref": "#/$defs/evidenceIds" },
				"analysisStatus": { "$ref": "#/$defs/analysisStatus" },
				"summary": { "$ref": "#/$defs/nullableText" },
				"routines": { "type": "array", "items": { "$ref": "#/$defs/routine" } },
				"operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
				"runtimeContext": {
					"type": "object",
					"additionalProperties": false,
					"required": ["clientServer", "effectiveIdentity", "requirements"],
					"properties": {
						"clientServer": { "$ref": "#/$defs/nullableText" },
						"effectiveIdentity": { "$ref": "#/$defs/nullableText" },
						"requirements": { "$ref": "#/$defs/strings" }
					}
				},
				"dependencyIds": { "$ref": "#/$defs/ids" },
				"findingIds": { "$ref": "#/$defs/ids" }
			}
		},
		"uiBehavior": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "classification", "isExecutable", "languageDetectionAttempted", "uiBehaviorType", "owner", "buttonName", "ruleType", "roles", "statuses", "showInBar", "showInMenu", "hideAttr", "hideWhen", "enableWhen", "visibilityFormula", "enablementFormula", "behavior", "formulaAnalysis", "evidenceId", "reviewNotes"],
			"properties": {
				"id": { "$ref": "#/$defs/text" },
				"classification": { "const": "UI_METADATA" },
				"isExecutable": { "const": false },
				"languageDetectionAttempted": { "const": false },
				"uiBehaviorType": { "enum": ["BUTTON_VISIBILITY", "BUTTON_ENABLEMENT"] },
				"owner": { "$ref": "#/$defs/script/properties/owner" },
				"buttonName": { "$ref": "#/$defs/nullableText" },
				"ruleType": { "$ref": "#/$defs/nullableText" },
				"roles": { "$ref": "#/$defs/strings" },
				"statuses": { "$ref": "#/$defs/strings" },
				"showInBar": { "type": ["boolean", "null"] },
				"showInMenu": { "type": ["boolean", "null"] },
				"hideAttr": { "type": ["string", "null"] },
				"hideWhen": { "type": ["string", "null"] },
				"enableWhen": { "type": ["string", "null"] },
				"visibilityFormula": { "$ref": "#/$defs/nullableText" },
				"enablementFormula": { "$ref": "#/$defs/nullableText" },
				"behavior": { "enum": ["ALWAYS_VISIBLE", "ALWAYS_ENABLED", "CONDITIONAL", "UNDETERMINED"] },
				"formulaAnalysis": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/uiFormula" } },
				"evidenceId": { "$ref": "#/$defs/text" },
				"reviewNotes": { "$ref": "#/$defs/strings" }
			},
			"allOf": [
				{
					"if": { "properties": { "uiBehaviorType": { "const": "BUTTON_VISIBILITY" } } },
					"then": { "properties": { "behavior": { "enum": ["ALWAYS_VISIBLE", "CONDITIONAL", "UNDETERMINED"] } } },
					"else": { "properties": { "behavior": { "enum": ["ALWAYS_ENABLED", "CONDITIONAL", "UNDETERMINED"] } } }
				}
			]
		},
		"uiFormula": {
			"type": "object",
			"additionalProperties": false,
			"required": ["property", "expression", "language", "summary", "referencedFields", "evidenceId"],
			"properties": {
				"property": { "enum": ["hideWhen", "enableWhen"] },
				"expression": { "$ref": "#/$defs/text" },
				"language": { "const": "FORMULA" },
				"summary": { "$ref": "#/$defs/nullableText" },
				"referencedFields": { "$ref": "#/$defs/strings" },
				"evidenceId": { "$ref": "#/$defs/text" }
			}
		},
		"routine": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "kind", "signature", "evidenceIds", "regionIds"],
			"properties": {
				"id": { "$ref": "#/$defs/text" },
				"name": { "$ref": "#/$defs/text" },
				"kind": { "$ref": "#/$defs/text" },
				"signature": { "$ref": "#/$defs/nullableText" },
				"regionIds": { "$ref": "#/$defs/evidenceIds" },
				"evidenceIds": { "$ref": "#/$defs/evidenceIds" }
			}
		},
		"operation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "kind", "description", "inputs", "outputs", "evidenceIds", "regionIds"],
			"properties": {
				"id": { "$ref": "#/$defs/text" },
				"kind": { "$ref": "#/$defs/text" },
				"description": { "$ref": "#/$defs/text" },
				"inputs": { "$ref": "#/$defs/strings" },
				"outputs": { "$ref": "#/$defs/strings" },
				"regionIds": { "$ref": "#/$defs/evidenceIds" },
				"evidenceIds": { "$ref": "#/$defs/evidenceIds" }
			}
		},
		"dependency": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "sourceId", "targetId", "targetReference", "resolutionStatus", "evidenceIds", "regionIds"],
			"properties": {
				"id": { "$ref": "#/$defs/text" },
				"type": { "$ref": "#/$defs/text" },
				"sourceId": { "$ref": "#/$defs/text" },
				"targetId": { "$ref": "#/$defs/nullableText" },
				"targetReference": { "$ref": "#/$defs/text" },
				"resolutionStatus": { "enum": ["RESOLVED", "EXTERNAL", "UNRESOLVED"] },
				"regionIds": { "$ref": "#/$defs/evidenceIds" },
				"evidenceIds": { "$ref": "#/$defs/evidenceIds" }
			}
		},
		"finding": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "code", "severity", "message", "artifactIds", "evidenceIds", "regionIds", "blocksImplementation"],
			"properties": {
				"id": { "$ref": "#/$defs/text" },
				"code": { "enum": ["MISSING_SOURCE", "SOURCE_CONFLICT", "UNKNOWN_LANGUAGE", "UNKNOWN_CONTEXT", "DYNAMIC_REFERENCE", "UNRESOLVED_REFERENCE", "UNSUPPORTED_LOGIC", "SOURCE_REDACTED", "INCOMPLETE_EXPORT", "VALIDATION_FAILURE"] },
				"severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
				"message": { "$ref": "#/$defs/text" },
				"regionIds": { "$ref": "#/$defs/ids" },
				"resolutionAttempted": { "type": "boolean" },
				"attemptedScopes": { "$ref": "#/$defs/strings" },
				"artifactIds": { "$ref": "#/$defs/ids" },
				"evidenceIds": { "$ref": "#/$defs/ids" },
				"blocksImplementation": { "type": "boolean" }
			},
			"allOf": [
				{
					"if": { "properties": { "code": { "enum": ["UNKNOWN_LANGUAGE", "UNRESOLVED_REFERENCE"] } } },
					"then": { "properties": { "regionIds": { "minItems": 1 }, "artifactIds": { "minItems": 1 } } }
				},
				{
					"if": { "properties": { "code": { "const": "UNRESOLVED_REFERENCE" } } },
					"then": {
						"required": ["resolutionAttempted", "attemptedScopes"],
						"properties": {
							"resolutionAttempted": { "const": true },
							"attemptedScopes": { "minItems": 1 }
						}
					}
				}
			]
		},
		"check": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "status", "detail", "findingIds"],
			"properties": {
				"name": { "enum": ["STRUCTURE", "SCOPE", "PROVENANCE", "COVERAGE", "REFERENCES", "SEMANTICS", "READINESS"] },
				"status": { "$ref": "#/$defs/checkStatus" },
				"detail": { "$ref": "#/$defs/text" },
				"findingIds": { "$ref": "#/$defs/ids" }
			}
		},
		"coverage": {
			"type": "object",
			"additionalProperties": false,
			"required": ["area", "status", "discoveredCount", "representedCount", "unresolvedCount", "sourceCompleteness"],
			"properties": {
				"area": { "enum": ["LOTUSSCRIPT", "FORMULA_LANGUAGE", "JAVA_AGENTS", "SCRIPT_LIBRARIES"] },
				"status": { "enum": ["ANALYZED", "REVIEW_REQUIRED", "NO_SOURCE_DISCOVERED"] },
				"discoveredCount": { "type": "integer", "minimum": 0 },
				"representedCount": { "type": "integer", "minimum": 0 },
				"unresolvedCount": { "type": "integer", "minimum": 0 },
				"sourceCompleteness": { "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] }
			}
		}
	}
}
