        "Form Event [onsubmit]:\nSub Onsubmit(Source As Notesuidocument, Continue As Variant)\n\tOn Error Goto ERR_HANDLE\n\tDim objAddInfo\t\tAs clsAddressInfo\n\tDim doc\t\t\tAs NotesDocument\n\tDim blnRes\t\t\tAs Boolean\n\tDim strTime\t\tAs String\n\tDim strUserID\t\tAs String\n\tDim nmUserID\t\tAs NotesName\n\tDim strRetMsg\t\tAs String\n\tSet objAddInfo = New clsAddressInfo(\"\")\n\tSet doc\t\t\t= Source.Document\n\tContinue = True\n\tblnRes = funcErrChkDate( Source )\n\tIf blnRes = False Then\n\t\tContinue = False\n\t\tExit Sub\n\tElse\n\t\tstrTime = Format$( Today, \"yyyy/mm/dd\" )\n\t\tIf objAddInfo.InfoFlag = True Then\n\t\t\tSet nmUserID = New NotesName( objAddInfo.UserID )\n\t\t\tstrUserID = nmUserID.Abbreviated\n\t\tElse\n\t\t\tstrRetMsg = funcReturnMsg( \"E019\" )\n\t\t\tMsgbox strRetMsg, 0 + 16, \"システムエラー\"\n\t\t\tContinue = False\n\t\t\tExit Sub\n\t\tEnd If\n\t\tdoc.UpdtDate = strTime\n\t\tdoc.UpdtUser = strUserID\n\tEnd If\n\tExit Sub\nERR_HANDLE:\n\tstrRetMsg = funcReturnMsg( \"E020\" )\n\tMsgbox strRetMsg & Chr(13) & Chr(10) & Chr(13) & Chr(10) & _\n\tfuncOnErrorMsg(\"Onsubmit\",Err, Erl, Error$), 16, \"システムエラー\"\n\tIf doc Is Nothing Then\n\tElse\n\t\tdoc.SaveOptions = \"0\"\n\t\tCall Source.Close( False )\n\tEnd If\n\tExit Sub\nEnd Sub",
