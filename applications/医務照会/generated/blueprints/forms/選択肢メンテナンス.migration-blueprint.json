    {
      "id": "49257BE3002293FD:formAction:b4856f9c3e3b152140c1",
      "name": null,
      "actionType": null,
      "purpose": null,
      "visibilityRules": [],
      "dependencies": [],
      "sourceReference": {
        "artifactPath": "input\\ExtractedJson\\synopsis.json",
        "jsonPointer": "/Forms/3/Actions/6"
      },
      "source": "Form Event [onsubmit]:\nSub Onsubmit( Source As Notesuidocument, Continue As Variant )\n\tOn Error Goto ERR_TRAP\n\tDim objAddInfo\t\tAs clsAddressInfo\n\tDim ws \t\t\tAs NotesUIWorkspace\n\tDim ss\t\t\t\tAs NotesSession\n\tDim db\t\t\t\tAs NotesDatabase\n\tDim doc\t\t\tAs NotesDocument\n\tDim strTime\t\tAs String\n\tDim strUserID\t\tAs String\n\tDim strRetMsg\t\tAs String\n\tDim blnChkErrRes\tAs Boolean\n\tDim blnRet\t\t\tAs Boolean\n\tDim nmUserID\t\tAs NotesName\n\tSet ws = New NotesUIWorkspace\n\tSet ss = New NotesSession\n\tSet objAddInfo = New clsAddressInfo(\"\")\n\tSet db = ss.CurrentDatabase\n\tSet Source = ws.CurrentDocument\n\tSet doc = Source.Document\n\tContinue = True\n\tblnChkErrRes = funcErrChkMente( Source, blnRet )\n\tIf blnChkErrRes = False Then\n\t\tContinue = False\n\t\tExit Sub\n\tElseif blnRet = False Then\n\t\tContinue = False\n\t\tExit Sub\n\tElse\n\t\tstrTime = Format$( Today, \"yyyy/mm/dd\" )\n\t\tIf objAddInfo.InfoFlag = True Then\n\t\t\tSet nmUserID = New NotesName( objAddInfo.UserID )\n\t\t\tstrUserID = nmUserID.Abbreviated\n\t\tElse\n\t\t\tstrRetMsg = funcReturnMsg( \"E019\" )\n\t\t\tMsgbox strRetMsg, 0 + 16, \"システムエラー\"\n\t\t\tContinue = False\n\t\t\tExit Sub\n\t\tEnd If\n\t\tdoc.UpdtDate = strTime\n\t\tdoc.UpdtUser = strUserID\n\tEnd If\n\tExit Sub\nERR_TRAP:\n\tstrRetMsg = funcReturnMsg( \"E020\" )\n\tMsgbox strRetMsg & Chr(13) & Chr(10) & Chr(13) & Chr(10) & _\n\tfuncOnErrorMsg(\"Onsubmit\",Err, Erl, Error$), 16, \"システムエラー\"\n\tContinue = False\n\tIf doc Is Nothing Then\n\tElse\n\t\tdoc.SaveOptions = \"0\"\n\t\tCall Source.Close( False )\n\tEnd If\n\tExit Sub\nEnd Sub"
    },
