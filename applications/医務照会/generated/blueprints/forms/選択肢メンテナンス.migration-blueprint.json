        "Form Script[funcErrChkMente]: Function funcErrChkMente( uidoc As NotesUIDocument ,blnErrRes As Boolean ) As Boolean\n\tOn Error Goto ERR_TRAP\n\tDim strErrMsg\t\t\t\tAs String\n\tDim strSortNo\t\t\t\tAs String\n\tDim strSelection\t\t\tAs String\n\tDim strErrList\t\t\t\tList As String\n\tDim intCount\t\t\t\tAs Integer\n\tfuncErrChkMente\t= True\n\tblnErrRes\t\t\t= True\n\tErase\t\t\t\tstrErrList\n\tintCount\t\t\t= 0\n\tstrErrMsg\t\t\t= \"以下のエラーが発生しました。確認してください。\" & Chr(13) & Chr(10)\n\tstrSortNo = uidoc.FieldGetText( \"SortNo\" )\n\tIf strSortNo = \"\" Then\n\t\tstrErrMsg = strErrMsg & Chr(13) & Chr(10) & \"ソート順を入力してください\"\n\t\tstrErrList( intCount ) = \"SortNo\"\n\t\tintCount = intCount + 1\n\t\tblnErr...",
